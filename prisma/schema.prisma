generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  nameAr              String?
  slug                String               @unique
  currency            String               @default("USD")
  locale              String               @default("en")
  timezone            String               @default("UTC")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  properties          Property[]
  propertyManagers    PropertyManager[]
  units               Unit[]
  tenants             Tenant[]
  leases              Lease[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  messages            Message[]
  activityLogs        ActivityLog[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("viewer")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, isActive])
}

model Property {
  id                  String               @id @default(cuid())
  organizationId      String               @default("org_default")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  nameAr              String?
  address             String
  addressAr           String?
  city                String
  cityAr              String?
  state               String?
  zipCode             String?
  description         String?
  descriptionAr       String?
  type                String               @default("residential")
  totalUnits          Int                  @default(0)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  units               Unit[]
  manager             PropertyManager?
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId, type])
  @@index([organizationId, city])
}

model PropertyManager {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String       @unique
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  nameAr         String?
  email          String
  phone          String?

  @@index([organizationId])
}

model Unit {
  id                  String               @id @default(cuid())
  organizationId      String               @default("org_default")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitNumber          String
  floor               Int?
  rooms               Int
  bathrooms           Float                @default(1)
  area                Float?
  rentAmount          Decimal              @db.Decimal(18, 2)
  status              String               @default("available")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@index([organizationId, status])
  @@index([propertyId])
}

model Tenant {
  id                  String               @id @default(cuid())
  organizationId      String               @default("org_default")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  nameAr              String?
  email               String
  phone               String?
  nationalId          String?
  emergencyContact    String?
  status              String               @default("active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  payments            Payment[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Lease {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  startDate      DateTime
  endDate        DateTime
  rentAmount     Decimal      @db.Decimal(18, 2)
  deposit        Decimal?     @db.Decimal(18, 2)
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       Payment[]

  @@index([organizationId, status])
  @@index([unitId])
  @@index([tenantId])
  @@index([endDate])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId        String
  lease          Lease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(18, 2)
  dueDate        DateTime
  paidDate       DateTime?
  status         String       @default("pending")
  method         String?
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([leaseId])
  @@index([tenantId])
  @@index([dueDate])
}

model MaintenanceRequest {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId         String?
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId       String?
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title          String
  titleAr        String?
  description    String
  descriptionAr  String?
  priority       String       @default("medium")
  status         String       @default("open")
  category       String       @default("other")
  assignedTo     String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([propertyId])
  @@index([priority])
}

model Message {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderName     String
  senderEmail    String
  subject        String
  content        String
  isRead         Boolean      @default(false)
  category       String       @default("general")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isRead])
  @@index([organizationId, category])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         String
  entity         String
  entityId       String?
  details        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entity])
  @@index([organizationId, createdAt])
}
