# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propmanager?schema=public"

# Required for signed HTTP-only sessions.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Bootstrap credentials used only when the first database user is created.
# After the first successful sign-in, users authenticate with database-backed accounts.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"
DEFAULT_ORGANIZATION_NAME="Default Organization"
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="UTC"

# Disabled by default in production.
ENABLE_DANGEROUS_ADMIN_ACTIONS="false"

# The copilot sends selected organization data to the configured AI provider.
# Review your privacy requirements before enabling it.
ENABLE_AI_COPILOT="false"
