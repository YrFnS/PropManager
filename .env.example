# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propmanager?schema=public"

# Required authentication settings
# Generate a secret with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Disabled by default in production
ENABLE_DANGEROUS_ADMIN_ACTIONS="false"

# The copilot sends selected portfolio data to the configured AI provider.
# Review your privacy requirements before enabling it.
ENABLE_AI_COPILOT="false"
